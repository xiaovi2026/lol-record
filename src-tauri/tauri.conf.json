{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lol-record",
  "version": "0.4.1",
  "identifier": "com.light.lol-record",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LoL Record - 英雄联盟对局录像分析",
        "width": 600,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
